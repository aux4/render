{
  "scope": "aux4",
  "name": "render",
  "version": "0.0.4",
  "description": "Render a JSON array from stdin as a human-readable list or table.",
  "license": "Apache-2.0",
  "git": "https://github.com/aux4/render",
  "tags": [
    "aux4",
    "json",
    "render",
    "list",
    "table",
    "csv"
  ],
  "dependencies": [
    "aux4/2table"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node",
      "linux:nodejs"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "render",
          "execute": [
            "profile:render"
          ],
          "help": {
            "text": "Render JSON from stdin as a human-readable list or table."
          }
        }
      ]
    },
    {
      "name": "render",
      "commands": [
        {
          "name": "list",
          "execute": [
            "stdin:node ${packageDir}/lib/aux4-render.mjs list values(primary, secondary, icon, badge)"
          ],
          "help": {
            "text": "Render a JSON array from stdin as a MUI-List-style view (icon, primary, secondary, badge).",
            "variables": [
              {
                "name": "primary",
                "text": "Primary line template. A bare field name (e.g. name), a string with $field tokens (e.g. \"$firstName $lastName\"), a value-map field[VALUE:label,...], or value formatting field{format:TYPE,...} (number|currency|percent|date|time|datetime). Note: field:transform colon syntax is no longer supported — use field{format:...}.",
                "arg": true,
                "default": ""
              },
              {
                "name": "secondary",
                "text": "Secondary line template. Bare field name, $field interpolation, value-map field[VALUE:label,...], or value formatting field{format:TYPE,...}.",
                "default": ""
              },
              {
                "name": "icon",
                "text": "Icon template rendered before the primary line. Bare field name, $field interpolation, value-map field[VALUE:label,...], or value formatting field{format:TYPE,...}.",
                "default": ""
              },
              {
                "name": "badge",
                "text": "Badge template, rendered right-aligned on the primary line (plain text, not interactive). Bare field name, $field interpolation, value-map field[VALUE:label,...], or value formatting field{format:TYPE,...}.",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "kv",
          "execute": [
            "stdin:node ${packageDir}/lib/aux4-render.mjs kv values(structure, index)"
          ],
          "help": {
            "text": "Render a JSON array from stdin as key=value (dotenv-style) lines, flattening each record's fields.",
            "variables": [
              {
                "name": "structure",
                "text": "Optional field structure (same grammar as render table/csv): comma-separated fields, field[sub1,sub2] nesting, field:\"Label\" rename, and field{format:TYPE,...} value formatting (number|currency|percent|date|time|datetime; options decimals, currency, locale, style). Omit to auto-flatten every field into dotted keys.",
                "arg": true,
                "default": ""
              },
              {
                "name": "index",
                "text": "Optional 0-based index selecting a single record from the top-level array. The selected record is rendered with no index prefix. Out of range exits 1. Omit to render every record.",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "yaml",
          "execute": [
            "stdin:node ${packageDir}/lib/aux4-render.mjs yaml values(structure, index)"
          ],
          "help": {
            "text": "Render a JSON array from stdin as YAML, preserving nesting (optionally selecting fields with the same structure grammar as render kv).",
            "variables": [
              {
                "name": "structure",
                "text": "Optional field structure (same grammar as render kv/table/csv): comma-separated fields, field[sub1,sub2] nesting, field:\"Label\" rename, and field{format:TYPE,...} value formatting (number|currency|percent|date|time|datetime; options decimals, currency, locale, style). Unlike kv the selection stays nested in the YAML output instead of flattening to dotted keys. Omit to dump the full record.",
                "arg": true,
                "default": ""
              },
              {
                "name": "index",
                "text": "Optional 0-based index selecting a single record from the top-level array. The selected record is rendered as a single YAML mapping. Out of range exits 1. Omit to render every record as a YAML sequence.",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "table",
          "execute": [
            "stdin:node ${packageDir}/lib/aux4-render.mjs table values(table, lineNumbers, showInvalidLines)"
          ],
          "help": {
            "text": "Render a JSON array from stdin as a table, delegating to aux4 2table.",
            "variables": [
              {
                "name": "table",
                "text": "The table structure to output (column list), forwarded verbatim to aux4 2table. Supports the full 2table grammar including field{format:TYPE,...} value formatting (number|currency|percent|date|time|datetime), which is applied by 2table.",
                "default": "",
                "arg": true
              },
              {
                "name": "lineNumbers",
                "text": "Add a first column with line numbers starting from 1 (forwarded to aux4 2table).",
                "default": "false"
              },
              {
                "name": "showInvalidLines",
                "text": "Show invalid lines as <invalid line> instead of skipping them (forwarded to aux4 2table).",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "csv",
          "execute": [
            "stdin:node ${packageDir}/lib/aux4-render.mjs csv values(table, lineNumbers, showInvalidLines)"
          ],
          "help": {
            "text": "Render a JSON array from stdin as CSV, delegating to aux4 2table --format csv.",
            "variables": [
              {
                "name": "table",
                "text": "The table structure to output (column list), forwarded verbatim to aux4 2table. Supports the full 2table grammar including field{format:TYPE,...} value formatting (number|currency|percent|date|time|datetime), which is applied by 2table.",
                "default": "",
                "arg": true
              },
              {
                "name": "lineNumbers",
                "text": "Add a first column with line numbers starting from 1 (forwarded to aux4 2table).",
                "default": "false"
              },
              {
                "name": "showInvalidLines",
                "text": "Show invalid lines as <invalid line> instead of skipping them (forwarded to aux4 2table).",
                "default": "false"
              }
            ]
          }
        }
      ]
    }
  ]
}
